---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import type { BreadcrumbItem } from '../components/ui/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';
import { getWhatsAppLink, hasWhatsApp } from '../lib/whatsapp';
import { SITE } from '../lib/site';
import { pathWithBase } from '../lib/path';

interface Props {
  title: string;
  description?: string;
  breadcrumbs: BreadcrumbItem[];
  intro?: string;
  area: 'industrial' | 'hospitalaria' | 'consultoria';
  eyebrow?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  imageCompact?: boolean;
  noindex?: boolean;
  embedded?: boolean;
  tipo?: 'solucion' | 'proyecto';
}

const {
  title,
  description,
  breadcrumbs,
  intro,
  area,
  eyebrow,
  image,
  imageAlt,
  imageCompact = false,
  noindex = false,
  embedded = false,
  tipo = 'solucion',
} = Astro.props;

const isProject =
  tipo === 'proyecto' ||
  Boolean(eyebrow?.toLowerCase().includes('proyecto')) ||
  breadcrumbs.some(
    (b) =>
      b.href === '/proyectos' ||
      b.href === pathWithBase('/proyectos') ||
      b.label.toLowerCase() === 'proyectos'
  );

const sidebarHeading = isProject
  ? '¿Necesita un proyecto similar?'
  : `Solicitar cotización de ${title}`;

const whatsappMessage = `Hola, quiero cotizar: ${title}`;
const isWhatsAppAvailable = hasWhatsApp();
const whatsappHref = isWhatsAppAvailable
  ? getWhatsAppLink(whatsappMessage)
  : pathWithBase('/contacto');

const ogImage = typeof image === 'string' ? image : image?.src;
---

{embedded ? (
  <div class="rounded-lg border border-line bg-white shadow-xs overflow-hidden">
    <PageHeader
      title={title}
      breadcrumbs={breadcrumbs}
      intro={intro}
      area={area}
      eyebrow={eyebrow}
    />

    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-8 space-y-10">
          {image && (
            <div
              class={`overflow-hidden rounded-lg border border-line bg-surface shadow-xs ${imageCompact ? 'max-w-md' : 'w-full'}`}
            >
              {typeof image === 'string' ? (
                <img
                  src={image}
                  alt={imageAlt || title}
                  class="w-full h-auto aspect-16/9 object-cover"
                />
              ) : (
                <Picture
                  src={image}
                  formats={['avif', 'webp']}
                  alt={imageAlt || title}
                  widths={[500, 800, 1200]}
                  sizes={
                    imageCompact ? '450px' : '(max-width: 1024px) 100vw, 800px'
                  }
                  class="w-full h-auto aspect-16/9 object-cover"
                  fetchpriority="high"
                />
              )}
            </div>
          )}
          <div class="prose prose-slate max-w-none text-ink leading-relaxed space-y-6">
            <slot />
          </div>
          <slot name="specs" />
          <slot name="multimedia" />
        </div>

        <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
          <div class="rounded border border-line bg-surface p-6 shadow-xs space-y-4">
            <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted">
              Cotización técnica
            </span>
            <h2 class="font-display text-lg font-semibold text-ink">
              {sidebarHeading}
            </h2>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">
              Consulte con nuestro equipo.
            </p>

            <div class="pt-2 flex flex-col gap-2.5">
              {isWhatsAppAvailable ? (
                <>
                  <Button
                    href={whatsappHref}
                    variant="primary"
                    size="md"
                    class="w-full"
                  >
                    WhatsApp
                  </Button>
                  <Button
                    href="/contacto"
                    variant="secondary"
                    size="md"
                    class="w-full"
                  >
                    Formulario de contacto
                  </Button>
                </>
              ) : (
                <Button
                  href="/contacto"
                  variant="primary"
                  size="md"
                  class="w-full"
                >
                  Solicitar cotización
                </Button>
              )}
            </div>

            <div class="pt-3 border-t border-line text-xs text-muted space-y-1">
              <span class="font-medium text-ink block">
                Atención telefónica:
              </span>
              <div class="flex items-center justify-between">
                <span>Central:</span>
                <a
                  href={`tel:${SITE.phoneRaw}`}
                  class="font-semibold text-ink hover:underline"
                >
                  {SITE.phone}
                </a>
              </div>
              <div class="flex items-center justify-between">
                <span>Administrativo:</span>
                <a
                  href={`tel:${SITE.phoneAdminRaw}`}
                  class="font-semibold text-ink hover:underline"
                >
                  {SITE.phoneAdmin}
                </a>
              </div>
              <div class="flex items-center justify-between">
                <span>Área técnica:</span>
                <a
                  href={`tel:${SITE.phoneTechnicalRaw}`}
                  class="font-semibold text-ink hover:underline"
                >
                  {SITE.phoneTechnical}
                </a>
              </div>
            </div>
          </div>

          <slot name="sidebar" />
        </aside>
      </div>
    </div>
  </div>
) : (
  <BaseLayout
    title={title}
    description={description || intro}
    image={ogImage}
    noindex={noindex}
    type={isProject ? 'project' : 'service'}
    breadcrumbs={breadcrumbs}
    serviceName={title}
    serviceDescription={description || intro}
  >
    <PageHeader
      title={title}
      breadcrumbs={breadcrumbs}
      intro={intro}
      area={area}
      eyebrow={eyebrow}
    />

    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-8 space-y-10">
          {image && (
            <div
              class={`overflow-hidden rounded-lg border border-line bg-surface shadow-xs ${imageCompact ? 'max-w-md' : 'w-full'}`}
            >
              {typeof image === 'string' ? (
                <img
                  src={image}
                  alt={imageAlt || title}
                  class="w-full h-auto aspect-16/9 object-cover"
                />
              ) : (
                <Picture
                  src={image}
                  formats={['avif', 'webp']}
                  alt={imageAlt || title}
                  widths={[500, 800, 1200]}
                  sizes={
                    imageCompact ? '450px' : '(max-width: 1024px) 100vw, 800px'
                  }
                  class="w-full h-auto aspect-16/9 object-cover"
                  fetchpriority="high"
                />
              )}
            </div>
          )}
          <div class="prose prose-slate max-w-none text-ink leading-relaxed space-y-6">
            <slot />
          </div>
          <slot name="specs" />
          <slot name="multimedia" />
        </div>

        <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
          <div class="rounded border border-line bg-surface p-6 shadow-xs space-y-4">
            <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted">
              Cotización técnica
            </span>
            <h2 class="font-display text-lg font-semibold text-ink">
              {sidebarHeading}
            </h2>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">
              Consulte con nuestro equipo.
            </p>

            <div class="pt-2 flex flex-col gap-2.5">
              {isWhatsAppAvailable ? (
                <>
                  <Button
                    href={whatsappHref}
                    variant="primary"
                    size="md"
                    class="w-full"
                  >
                    WhatsApp
                  </Button>
                  <Button
                    href="/contacto"
                    variant="secondary"
                    size="md"
                    class="w-full"
                  >
                    Formulario de contacto
                  </Button>
                </>
              ) : (
                <Button
                  href="/contacto"
                  variant="primary"
                  size="md"
                  class="w-full"
                >
                  Solicitar cotización
                </Button>
              )}
            </div>

            <div class="pt-3 border-t border-line text-xs text-muted space-y-1">
              <span class="font-medium text-ink block">
                Atención telefónica:
              </span>
              <div class="flex items-center justify-between">
                <span>Central:</span>
                <a
                  href={`tel:${SITE.phoneRaw}`}
                  class="font-semibold text-ink hover:underline"
                >
                  {SITE.phone}
                </a>
              </div>
              <div class="flex items-center justify-between">
                <span>Administrativo:</span>
                <a
                  href={`tel:${SITE.phoneAdminRaw}`}
                  class="font-semibold text-ink hover:underline"
                >
                  {SITE.phoneAdmin}
                </a>
              </div>
              <div class="flex items-center justify-between">
                <span>Área técnica:</span>
                <a
                  href={`tel:${SITE.phoneTechnicalRaw}`}
                  class="font-semibold text-ink hover:underline"
                >
                  {SITE.phoneTechnical}
                </a>
              </div>
            </div>
          </div>

          <slot name="sidebar" />
        </aside>
      </div>
    </div>
  </BaseLayout>
)}
