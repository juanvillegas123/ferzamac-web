---
export interface StatItem {
  value?: string | number | null;
  label: string;
}

interface Props {
  stats?: StatItem[];
  class?: string;
}

const { stats = [], class: className = '' } = Astro.props;

// Filtrar únicamente los ítems que contengan un número o cifra confirmada
const validStats = stats.filter(
  (s) => s.value !== undefined && s.value !== null && String(s.value).trim() !== ''
);

const hasStats = validStats.length > 0;
---

{
  hasStats && (
    <section class={`border-y border-line bg-surface py-8 ${className}`} aria-label="Cifras clave">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-4 text-center">
          {validStats.map((stat) => (
            <div class="space-y-1">
              <p class="font-display text-3xl sm:text-4xl font-bold text-ink">
                {stat.value}
              </p>
              <p class="text-xs sm:text-sm font-medium text-muted">
                {stat.label}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
