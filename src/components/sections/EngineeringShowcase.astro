---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

export interface ShowcaseImage {
  src: ImageMetadata;
  alt: string;
  label: string;
}

interface Props {
  title?: string;
  intro?: string;
  images?: ShowcaseImage[];
  ctaHref?: string;
  ctaLabel?: string;
  class?: string;
}

const {
  title = 'Ingeniería y desarrollo técnico',
  intro,
  images = [],
  ctaHref = '/consultoria',
  ctaLabel = 'Consultoría e ingeniería',
  class: className = '',
} = Astro.props;

const hasImages = images.length > 0;
---

{hasImages && (
  <section
    class={`py-16 sm:py-20 bg-surface border-y border-line ${className}`}
    aria-labelledby="showcase-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <SectionHeading
          eyebrow="Capacidad técnica"
          title={title}
          intro={intro}
        />
        {ctaHref && (
          <div>
            <Button href={ctaHref} variant="secondary" size="md">
              {ctaLabel}
            </Button>
          </div>
        )}
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {images.map((item) => (
          <div class="group overflow-hidden rounded border border-line bg-white shadow-xs">
            <div class="aspect-4/3 w-full overflow-hidden bg-ink-deep">
              <Picture
                src={item.src}
                formats={['avif', 'webp']}
                alt={item.alt}
                widths={[400, 700]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-102"
              />
            </div>
            <div class="p-4 border-t border-line">
              <p class="font-display text-sm font-semibold text-ink">
                {item.label}
              </p>
              <p class="text-xs text-muted mt-0.5">{item.alt}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
