---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';
import defaultHeroImage from '../../assets/images/home/hero-generacion-vapor-huacareta.jpg';

interface Props {
  title?: string;
  subtitle?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  backgroundImage?: ImageMetadata;
  class?: string;
}

const {
  title = 'Ingeniería, montaje y mantenimiento industrial y hospitalario',
  subtitle = 'Diseño y construcción de plantas, calderos de vapor, redes de piping y sistemas hospitalarios de agua purificada y aire comprimido en Bolivia.',
  primaryCta = { label: 'Área Industrial', href: '/industrial' },
  secondaryCta = { label: 'Área Hospitalaria', href: '/hospitalaria' },
  backgroundImage = defaultHeroImage,
  class: className = '',
} = Astro.props;
---

<section
  class={`relative overflow-hidden bg-ink-deep text-white min-h-[520px] sm:min-h-[580px] lg:min-h-[640px] flex items-center ${className}`}
  aria-label="Presentación principal"
>
  <!-- Imagen estática de fondo procesada con astro:assets -->
  <div class="absolute inset-0 z-0">
    <Picture
      src={backgroundImage}
      formats={['avif', 'webp']}
      alt="Caldero de vapor industrial instalado por Ferzamac"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-center"
    />
    <!-- Capa de color ink-deep al 75% para garantizar contraste WCAG sobre el fondo -->
    <div class="absolute inset-0 bg-ink-deep/75 backdrop-blur-[1px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl space-y-6">
      <div class="inline-flex items-center gap-2 rounded bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur-xs">
        <span class="h-2 w-2 rounded-full bg-industrial"></span>
        <span>Sucre · Cobertura a nivel Bolivia</span>
      </div>

      <h1 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl leading-tight">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-surface leading-relaxed max-w-2xl">
        {subtitle}
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        {primaryCta && (
          <Button href={primaryCta.href} variant="primary" size="lg" class="bg-white text-ink hover:bg-surface border-transparent">
            {primaryCta.label}
          </Button>
        )}
        {secondaryCta && (
          <Button href={secondaryCta.href} variant="secondary" size="lg" class="border-white text-white hover:bg-white/10">
            {secondaryCta.label}
          </Button>
        )}
      </div>
    </div>
  </div>
</section>
