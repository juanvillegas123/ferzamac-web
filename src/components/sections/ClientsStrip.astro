---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

export interface ClientItem {
  nombre: string;
  sector?: string;
  ciudad?: string;
  mostrarNombre: boolean;
  logo?: ImageMetadata;
}

interface Props {
  clientes?: ClientItem[];
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  clientes,
  title = 'Empresas y entidades que confían en nosotros',
  subtitle = 'Experiencia en proyectos del sector público y privado en Bolivia',
  class: className = '',
} = Astro.props;

// Obtener clientes desde props o directamente desde la colección
let clientList: ClientItem[] = [];

if (clientes && clientes.length > 0) {
  clientList = clientes;
} else {
  const collectionClients = await getCollection(
    'clientes',
    (c) => c.data.mostrarNombre
  );
  clientList = collectionClients.map((c) => ({
    nombre: c.data.nombre,
    sector: c.data.sector,
    ciudad: c.data.ciudad,
    mostrarNombre: c.data.mostrarNombre,
    logo: c.data.logo,
  }));
}

const activeClients = clientList.filter(
  (c) => c.mostrarNombre === true && Boolean(c.logo)
);
const hasActiveClients = activeClients.length > 0;

// Duplicar elementos para animación de carrusel continuo infinito
const marqueeClients = [...activeClients, ...activeClients];
---

{hasActiveClients && (
  <section
    class={`relative py-8 sm:py-10 bg-surface/50 border-t border-line overflow-hidden ${className}`}
    aria-labelledby="clients-strip-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center space-y-2 mb-5">
      <p class="text-xs font-bold uppercase tracking-wider text-muted">
        Clientes y contratantes
      </p>
      <h2
        id="clients-strip-title"
        class="font-display text-lg sm:text-xl font-semibold text-ink"
      >
        {title}
      </h2>
      {subtitle && (
        <p class="text-xs sm:text-sm text-muted max-w-xl mx-auto">{subtitle}</p>
      )}
    </div>

    {/* Contenedor del carrusel */}
    <div
      class="relative w-full overflow-hidden"
      role="region"
      aria-label="Carrusel continuo de clientes hacia la derecha"
    >
      {/* Máscaras de desvanecimiento laterales */}
      <div
        class="pointer-events-none absolute left-0 top-0 bottom-0 w-16 sm:w-32 bg-gradient-to-r from-surface to-transparent z-10"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute right-0 top-0 bottom-0 w-16 sm:w-32 bg-gradient-to-l from-surface to-transparent z-10"
        aria-hidden="true"
      ></div>

      {/* Pista animada de logos de clientes (giro a la derecha) */}
      <div class="marquee-track-right flex items-center gap-6 sm:gap-8 py-2">
        {marqueeClients.map((client) => (
          <div
            class="client-card flex items-center justify-center h-20 sm:h-22 w-52 sm:w-60 shrink-0 rounded-xl border border-line bg-white px-5 py-3 shadow-2xs transition-all duration-300 hover:shadow-xs hover:border-ink/30 hover:scale-102"
            title={client.nombre}
          >
            {client.logo && (
              <Image
                src={client.logo}
                alt={`Logo de ${client.nombre}`}
                class="h-11 sm:h-13 w-auto max-w-[155px] sm:max-w-[185px] object-contain opacity-100 transition-transform duration-300 hover:scale-105"
                loading="eager"
              />
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .marquee-track-right {
    width: max-content;
    display: flex;
    animation: marquee-right 28s linear infinite;
  }

  .marquee-track-right:hover {
    animation-play-state: paused;
  }

  @keyframes marquee-right {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track-right {
      animation: none;
      overflow-x: auto;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>
