---
import SectionHeading from '../ui/SectionHeading.astro';

export interface ProcessStep {
  number: string;
  title: string;
  description?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  steps?: ProcessStep[];
  class?: string;
}

const defaultSteps: ProcessStep[] = [
  {
    number: '01',
    title: 'Diseño',
  },
  {
    number: '02',
    title: 'Construcción',
  },
  {
    number: '03',
    title: 'Montaje',
  },
  {
    number: '04',
    title: 'Mantenimiento preventivo y correctivo',
  },
  {
    number: '05',
    title: 'Puesta en marcha',
  },
];

const {
  eyebrow = 'Metodología',
  title = 'Proceso de trabajo',
  intro,
  steps = defaultSteps,
  class: className = '',
} = Astro.props;
---

<section
  class={`py-16 sm:py-20 bg-white ${className}`}
  aria-labelledby="process-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      intro={intro}
      align="center"
    />

    <div
      class={`grid grid-cols-1 gap-6 sm:grid-cols-2 ${steps.length === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4'}`}
    >
      {steps.map((step) => (
        <div class="relative flex flex-col justify-start rounded border border-line bg-surface/50 p-6 shadow-xs space-y-3">
          <span class="font-display text-3xl font-bold text-ink/20">
            {step.number}
          </span>
          <h3 class="text-base sm:text-lg font-display font-semibold text-ink leading-snug">
            {step.title}
          </h3>
          {step.description && (
            <p class="text-sm text-muted leading-relaxed">{step.description}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
