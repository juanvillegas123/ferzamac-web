---
import SectionHeading from '../ui/SectionHeading.astro';

export interface ProcessStep {
  number: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  steps?: ProcessStep[];
  class?: string;
}

const defaultSteps: ProcessStep[] = [
  {
    number: '01',
    title: 'Diseño',
    description:
      'Levantamiento técnico, cálculo y desarrollo de planos de ingeniería.',
  },
  {
    number: '02',
    title: 'Fabricación',
    description:
      'Construcción mecánica, calderería y mecanizado en taller especializado.',
  },
  {
    number: '03',
    title: 'Instalación',
    description:
      'Montaje en obra, interconexión de líneas y pruebas operativas.',
  },
  {
    number: '04',
    title: 'Mantenimiento',
    description:
      'Planes preventivos y soporte técnico para continuidad de operación.',
  },
];

const {
  eyebrow = 'Metodología',
  title = 'Proceso de trabajo',
  intro,
  steps = defaultSteps,
  class: className = '',
} = Astro.props;
---

<section
  class={`py-16 sm:py-20 bg-white ${className}`}
  aria-labelledby="process-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      intro={intro}
      align="center"
    />

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <div class="relative flex flex-col rounded border border-line bg-surface/50 p-6 shadow-xs space-y-3">
          <span class="font-display text-3xl font-bold text-ink/20">
            {step.number}
          </span>
          <h3 class="text-lg font-display font-semibold text-ink">
            {step.title}
          </h3>
          <p class="text-sm text-muted leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
