---
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import Button from '../ui/Button.astro';
import sampleProjectImg1 from '../../assets/images/fotogramas/huacareta-clasificacion-naranjas-lavado.png';
import sampleProjectImg2 from '../../assets/images/fotogramas/camara-de-frio-sopachuy-puerta.png';
import sampleProjectImg3 from '../../assets/images/fotogramas/cajon-noqueo-vacuno-sopachuy-nave.png';

export interface FeaturedProjectItem {
  title: string;
  href: string;
  area: 'industrial' | 'hospitalaria';
  location?: string;
  summary: string;
  image?: ImageMetadata;
  scope?: string[];
}

interface Props {
  title?: string;
  intro?: string;
  projects?: FeaturedProjectItem[];
  class?: string;
}

const defaultProjects: FeaturedProjectItem[] = [
  {
    title: 'Planta procesadora de cítricos',
    href: '/proyectos/planta-huacareta',
    area: 'industrial',
    location: 'Huacareta, Chuquisaca',
    summary: 'Diseño, fabricación y montaje de línea completa de lavado, selección, secado y clasificación por calibres.',
    image: sampleProjectImg1,
    scope: ['Caldero de vapor', 'Cintas de transporte', 'Paneles de control'],
  },
  {
    title: 'Cámara frigorífica industrial',
    href: '/proyectos/camara-frio-sopachuy',
    area: 'industrial',
    location: 'Sopachuy, Chuquisaca',
    summary: 'Instalación de paneles aislantes, puertas frigoríficas, evaporadores y sistema electromecánico de control térmico.',
    image: sampleProjectImg2,
    scope: ['Tablero electromecánico', 'Cortinas PVC', 'Circuito frigorífico'],
  },
  {
    title: 'Infraestructura de faena y procesamiento',
    href: '/proyectos/matadero-sopachuy',
    area: 'industrial',
    location: 'Sopachuy, Chuquisaca',
    summary: 'Construcción y montaje de cajón de noqueo, rielería aérea estructural en acero y líneas de faena especializada.',
    image: sampleProjectImg3,
    scope: ['Estructuras de acero', 'Mecanismos neumáticos', 'Rielería aérea'],
  },
];

const {
  title = 'Proyectos destacados',
  intro = 'Experiencia comprobada en plantas de procesamiento, sistemas térmicos y montaje electromecánico en el sur de Bolivia.',
  projects = defaultProjects,
  class: className = '',
} = Astro.props;
---

<section class={`py-16 sm:py-20 bg-white ${className}`} aria-labelledby="featured-projects-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <SectionHeading
        eyebrow="Casos reales"
        title={title}
        intro={intro}
      />
      <div>
        <Button href="/proyectos" variant="secondary" size="md">
          Ver todos los proyectos
        </Button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((project) => (
          <ProjectCard
            title={project.title}
            href={project.href}
            area={project.area}
            location={project.location}
            summary={project.summary}
            image={project.image}
            scope={project.scope}
          />
        ))
      }
    </div>
  </div>
</section>
