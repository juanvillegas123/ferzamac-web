---
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import Button from '../ui/Button.astro';

export interface FeaturedProjectItem {
  title: string;
  href: string;
  area: 'industrial' | 'hospitalaria';
  location?: string;
  summary: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageAspectRatio?: '16/9' | '4/3' | '3/4' | '1/1';
  imagePosition?: string;
  scope?: string[];
}

interface Props {
  title?: string;
  intro?: string;
  projects?: FeaturedProjectItem[];
  class?: string;
}

const {
  title = 'Proyectos destacados',
  intro,
  projects = [],
  class: className = '',
} = Astro.props;

const hasProjects = projects.length > 0;
---

{hasProjects && (
  <section
    class={`py-16 sm:py-20 bg-white ${className}`}
    aria-labelledby="featured-projects-title"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <SectionHeading eyebrow="Casos reales" title={title} intro={intro} />
        <div>
          <Button href="/proyectos" variant="secondary" size="md">
            Ver todos los proyectos
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <ProjectCard
            title={project.title}
            href={project.href}
            area={project.area}
            location={project.location}
            summary={project.summary}
            image={project.image}
            imageAlt={project.imageAlt}
            imageAspectRatio={project.imageAspectRatio}
            imagePosition={project.imagePosition}
            scope={project.scope}
          />
        ))}
      </div>
    </div>
  </section>
)}
