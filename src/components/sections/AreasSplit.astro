---
import SectionHeading from '../ui/SectionHeading.astro';
import AreaCard from '../ui/AreaCard.astro';
import { pathWithBase } from '../../lib/path';

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  industrialTitle?: string;
  industrialDescription?: string;
  industrialHighlights?: string[];
  hospitalariaTitle?: string;
  hospitalariaDescription?: string;
  hospitalariaHighlights?: string[];
  class?: string;
}

const {
  eyebrow = 'Áreas de especialidad',
  title = 'Divisiones técnicas',
  intro,
  industrialTitle = 'Área Industrial',
  industrialDescription = 'Diseño, construcción, montaje y mantenimiento para el sector industrial.',
  industrialHighlights = [],
  hospitalariaTitle = 'Área Hospitalaria',
  hospitalariaDescription = 'Sistemas especializados de agua purificada, aire comprimido y redes hospitalarias.',
  hospitalariaHighlights = [],
  class: className = '',
} = Astro.props;
---

<section
  class={`py-16 sm:py-20 bg-surface/50 ${className}`}
  aria-labelledby="areas-split-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      intro={intro}
      align="center"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <AreaCard
        title={industrialTitle}
        href={pathWithBase('/industrial')}
        area="industrial"
        description={industrialDescription}
        highlights={industrialHighlights}
      />

      <AreaCard
        title={hospitalariaTitle}
        href={pathWithBase('/hospitalaria')}
        area="hospitalaria"
        description={hospitalariaDescription}
        highlights={hospitalariaHighlights}
      />
    </div>
  </div>
</section>
