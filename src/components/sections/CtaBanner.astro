---
import Button from '../ui/Button.astro';
import { getWhatsAppLink, hasWhatsApp } from '../../lib/whatsapp';

interface Props {
  title?: string;
  description?: string;
  ctaText?: string;
  whatsappMessage?: string;
  class?: string;
}

const {
  title = 'Consulta técnica y cotizaciones',
  description = 'Comuníquese con nuestro equipo para evaluar los requerimientos de su planta o proyecto.',
  ctaText = 'Solicitar cotización',
  whatsappMessage = 'Hola, deseo solicitar una cotización técnica',
  class: className = '',
} = Astro.props;

const isWhatsAppAvailable = hasWhatsApp();
const targetHref = isWhatsAppAvailable
  ? getWhatsAppLink(whatsappMessage)
  : '/contacto';
const effectiveCtaText = isWhatsAppAvailable ? ctaText : 'Solicitar cotización';
---

<section
  class={`bg-ink-deep text-white py-14 sm:py-16 ${className}`}
  aria-label="Llamado a la acción"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8 max-w-4xl lg:max-w-none mx-auto">
      <div class="space-y-3">
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-white tracking-tight">
          {title}
        </h2>
        <p class="text-surface text-sm sm:text-base max-w-2xl leading-relaxed">
          {description}
        </p>
      </div>

      <div class="shrink-0 flex flex-wrap gap-4 items-center">
        <Button
          href={targetHref}
          variant="inverted"
          size="lg"
        >
          {effectiveCtaText}
        </Button>
        <Button
          href="/contacto"
          variant="secondary"
          size="lg"
          class="border-white text-white hover:bg-white/10"
        >
          Ver datos de contacto
        </Button>
      </div>
    </div>
  </div>
</section>
