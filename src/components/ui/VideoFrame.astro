---
import { pathWithBase } from '../../lib/path';

interface Props {
  src: string;
  poster?: string;
  orientation?: 'wide' | 'vertical';
  caption?: string;
  class?: string;
}

const {
  src,
  poster,
  orientation = 'wide',
  caption,
  class: className = '',
} = Astro.props;

const videoSrc = pathWithBase(src);
const videoPoster = poster ? pathWithBase(poster) : undefined;

const orientationClasses = {
  wide: 'aspect-16/9 w-full max-w-4xl',
  vertical: 'aspect-9/16 w-full max-w-[300px] sm:max-w-[340px] mx-auto',
};
---

<figure class={`m-0 flex flex-col ${className}`}>
  <div
    class={`relative overflow-hidden rounded border border-line bg-ink-deep ${orientationClasses[orientation]}`}
  >
    <video
      class="video-frame-player h-full w-full object-cover"
      src={videoSrc}
      poster={videoPoster}
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={caption || 'Video de demostración industrial'}
    >
      <p class="p-4 text-xs text-white">
        Su navegador no soporta la reproducción de video HTML5.
      </p>
    </video>
  </div>
  {caption && (
    <figcaption class="mt-2 text-xs text-muted leading-normal">
      {caption}
    </figcaption>
  )}
</figure>

<script>
  function setupVideoFrames() {
    const videos = document.querySelectorAll<HTMLVideoElement>(
      '.video-frame-player'
    );
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    videos.forEach((video) => {
      if (prefersReducedMotion) {
        // En usuarios con preferencia de movimiento reducido, no reproducir automáticamente
        video.controls = true;
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              video.play().catch(() => {
                // Silently catch autoplay policies
                video.controls = true;
              });
            } else {
              video.pause();
            }
          });
        },
        { threshold: 0.25 }
      );

      observer.observe(video);
    });
  }

  setupVideoFrames();
  document.addEventListener('astro:after-swap', setupVideoFrames);
</script>
