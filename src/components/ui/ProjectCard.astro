---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Badge from './Badge.astro';

interface Props {
  title: string;
  href: string;
  area: 'industrial' | 'hospitalaria';
  location?: string;
  summary: string;
  image?: ImageMetadata;
  scope?: string[];
  class?: string;
}

const {
  title,
  href,
  area,
  location,
  summary,
  image,
  scope,
  class: className = '',
} = Astro.props;

const areaAccents = {
  industrial: 'border-t-industrial hover:border-industrial/60',
  hospitalaria: 'border-t-hospitalaria hover:border-hospitalaria/60',
};

const areaLabels = {
  industrial: 'Industrial',
  hospitalaria: 'Hospitalaria',
};
---

<article
  class={`group relative flex flex-col overflow-hidden rounded border border-line bg-white shadow-xs transition-shadow duration-200 hover:shadow-md border-t-4 ${areaAccents[area]} ${className}`}
>
  {image && (
    <div class="aspect-16/9 w-full overflow-hidden bg-surface">
      <Picture
        src={image}
        formats={['avif', 'webp']}
        alt={title}
        widths={[400, 700]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-102"
      />
    </div>
  )}

  <div class="flex flex-1 flex-col p-5 space-y-3">
    <div class="flex items-center justify-between gap-2">
      <Badge variant={area}>{areaLabels[area]}</Badge>
      {location && (
        <span class="text-xs text-muted font-medium">{location}</span>
      )}
    </div>

    <h3 class="text-lg font-display font-semibold text-ink transition-colors group-hover:text-ink-deep leading-snug">
      <a
        href={href}
        class="focus-visible:outline-2 focus-visible:outline-ink focus-visible:outline-offset-2 rounded"
      >
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <p class="text-sm text-muted line-clamp-3 leading-relaxed flex-1">
      {summary}
    </p>

    {scope && scope.length > 0 && (
      <ul class="pt-2 border-t border-line space-y-1 text-xs text-muted">
        {scope.slice(0, 3).map((item) => (
          <li class="flex items-start gap-1.5 truncate">
            <span class="text-ink font-bold">•</span>
            <span class="truncate">{item}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="pt-2 flex items-center gap-1 text-xs font-semibold text-ink group-hover:underline">
      <span>Ver ficha técnica de proyecto</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</article>
