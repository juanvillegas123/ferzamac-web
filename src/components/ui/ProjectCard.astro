---
import type { ImageMetadata } from 'astro';
import { Picture, Image } from 'astro:assets';
import Badge from './Badge.astro';

interface Props {
  title: string;
  href: string;
  area: 'industrial' | 'hospitalaria' | 'consultoria';
  location?: string;
  summary: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageAspectRatio?: '16/9' | '4/3' | '3/4' | '1/1';
  imagePosition?: string;
  scope?: string[];
  clientLogo?: ImageMetadata;
  clientName?: string;
  class?: string;
}

const {
  title,
  href,
  area,
  location,
  summary,
  image,
  imageAlt,
  imageAspectRatio = '16/9',
  imagePosition = 'object-center',
  scope,
  clientLogo,
  clientName,
  class: className = '',
} = Astro.props;

const aspectClasses = {
  '16/9': 'aspect-16/9',
  '4/3': 'aspect-4/3',
  '3/4': 'aspect-3/4',
  '1/1': 'aspect-square',
};

const areaAccents = {
  industrial: 'border-t-industrial hover:border-industrial/60',
  hospitalaria: 'border-t-hospitalaria hover:border-hospitalaria/60',
  consultoria: 'border-t-ink hover:border-ink/60',
};

const areaLabels = {
  industrial: 'Industrial',
  hospitalaria: 'Hospitalaria',
  consultoria: 'Consultoría',
};
---

<article
  class={`group relative flex flex-col overflow-hidden rounded border border-line bg-white shadow-xs transition-shadow duration-200 hover:shadow-md border-t-4 ${areaAccents[area]} ${className}`}
>
  {image && (
    <div
      class={`${aspectClasses[imageAspectRatio]} relative w-full overflow-hidden bg-surface`}
    >
      <Picture
        src={image}
        formats={['avif', 'webp']}
        alt={imageAlt || title}
        widths={[400, 700]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        class={`h-full w-full object-cover ${imagePosition} transition-transform duration-200 group-hover:scale-102`}
      />
      {clientLogo && (
        <div
          class="absolute top-3 right-3 z-10 flex items-center justify-center rounded bg-white/95 px-2.5 py-1.5 shadow-xs border border-line/90 backdrop-blur-xs transition-transform duration-200 group-hover:scale-105"
          title={clientName ? `Proyecto ejecutado para: ${clientName}` : 'Cliente / Entidad contratante'}
        >
          <Image
            src={clientLogo}
            alt={clientName ? `Logo de ${clientName}` : 'Logo del cliente'}
            class="h-6 w-auto max-w-[85px] object-contain"
            loading="eager"
          />
        </div>
      )}
    </div>
  )}

  <div class="flex flex-1 flex-col p-5 space-y-3">
    <div class="flex items-center justify-between gap-2">
      <Badge variant={area}>{areaLabels[area]}</Badge>
      {clientLogo && !image ? (
        <div
          class="flex items-center justify-center rounded bg-surface px-2 py-1 border border-line shadow-2xs"
          title={clientName ? `Proyecto ejecutado para: ${clientName}` : 'Cliente'}
        >
          <Image
            src={clientLogo}
            alt={clientName || 'Cliente'}
            class="h-5 w-auto max-w-[75px] object-contain"
            loading="eager"
          />
        </div>
      ) : (
        location && (
          <span class="text-xs text-muted font-medium">{location}</span>
        )
      )}
    </div>

    <h3 class="text-lg font-display font-semibold text-ink transition-colors group-hover:text-ink-deep leading-snug">
      <a
        href={href}
        class="focus-visible:outline-2 focus-visible:outline-ink focus-visible:outline-offset-2 rounded"
      >
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <p class="text-sm text-muted line-clamp-3 leading-relaxed flex-1">
      {summary}
    </p>

    {scope && scope.length > 0 && (
      <ul class="pt-2 border-t border-line space-y-1 text-xs text-muted">
        {scope.slice(0, 3).map((item) => (
          <li class="flex items-start gap-1.5 truncate">
            <span class="text-ink font-bold">•</span>
            <span class="truncate">{item}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="pt-2 flex items-center gap-1 text-xs font-semibold text-ink group-hover:underline">
      <span>Ver ficha técnica de proyecto</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</article>
