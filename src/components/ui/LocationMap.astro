---
import { SITE } from '../../lib/site';

interface Props {
  variant?: 'card' | 'footer';
  class?: string;
}

const { variant = 'card', class: className = '' } = Astro.props;

// Dirección oficial
const addressText = SITE.address;

// URL referencial para el mapa (la ubicación exacta del pin aún no está fijada por el cliente)
// TODO: fijar ubicación exacta del pin de Google Maps cuando el cliente la confirme
const isPinFixed = Boolean(SITE.mapsUrl && SITE.mapsUrl.trim() !== '');

const directionsUrl = isPinFixed
  ? SITE.mapsUrl!
  : 'https://maps.google.com/?q=Calle+Ren%C3%A9+Moreno,+Sucre,+Bolivia';

// Embed para mapa interactivo (centrado en la zona de René Moreno, Sucre sin fijar pin definitivo)
const embedSrc = isPinFixed && SITE.mapsUrl!.includes('embed')
  ? SITE.mapsUrl!
  : 'https://maps.google.com/maps?q=Calle+Ren%C3%A9+Moreno,+Sucre,+Bolivia&t=&z=15&ie=UTF8&iwloc=&output=embed';
---

<div
  class:list={[
    'location-map-container',
    variant === 'card' && 'rounded-lg border border-line bg-surface p-6 shadow-xs space-y-4',
    variant === 'footer' && 'space-y-2 text-sm text-surface',
    className,
  ]}
>
  {/* Encabezado y dirección */}
  <div class="space-y-1.5">
    {variant === 'card' && (
      <span class="text-xs font-bold uppercase tracking-wider text-muted">
        Ubicación física
      </span>
    )}
    <div class="flex items-start gap-2">
      <svg
        class="h-5 w-5 shrink-0 text-muted mt-0.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
        />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
        />
      </svg>
      <div>
        <p class:list={[variant === 'card' ? 'font-display text-base font-semibold text-ink' : 'text-sm text-surface']}>
          {addressText}
        </p>
        <p class:list={[variant === 'card' ? 'text-xs text-muted' : 'text-xs text-surface/80']}>
          Sucre, Bolivia
        </p>
      </div>
    </div>
  </div>

  {/* Variante tarjeta (en página /contacto): Mapa interactivo visible directamente */}
  {variant === 'card' ? (
    <div class="space-y-3 pt-1">
      <div class="flex items-center justify-between gap-4">
        <span class="text-xs text-muted">
          <!-- TODO: ubicación exacta del pin pendiente de confirmación -->
          Zona referencial en Sucre
        </span>
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs font-semibold text-ink hover:underline focus-visible:outline-2 focus-visible:outline-ink rounded"
        >
          <span>Cómo llegar</span>
          <svg class="h-3.5 w-3.5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="w-full overflow-hidden rounded border border-line bg-surface shadow-2xs">
        <iframe
          src={embedSrc}
          loading="lazy"
          width="100%"
          height="280"
          style="border: 0;"
          title="Mapa interactivo de ubicación de Ferzamac en Sucre, Bolivia"
          allowfullscreen=""
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full block"
        ></iframe>
      </div>
    </div>
  ) : (
    /* Variante footer: Carga diferida interactiva o enlace externo para evitar iframes pesados en el pie de página */
    <div class="space-y-2 pt-1">
      <div class="flex flex-wrap items-center gap-3">
        <button
          type="button"
          class="btn-load-map inline-flex items-center gap-1.5 rounded border border-white/20 bg-white/10 px-2.5 py-1 text-xs font-medium text-white hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-white transition-colors"
          data-embed-url={embedSrc}
          aria-expanded="false"
        >
          <svg class="h-3.5 w-3.5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          Ver mapa
        </button>

        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs text-surface hover:text-white hover:underline focus-visible:outline-2 focus-visible:outline-white rounded"
        >
          <span>Cómo llegar</span>
          <svg class="h-3 w-3 text-surface/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div
        class="map-frame-wrapper hidden w-full overflow-hidden rounded border border-white/20 bg-black/20 mt-2"
        style="min-height: 200px;"
      >
        {/* El iframe se inyecta por JavaScript únicamente al pulsar 'Ver mapa' en el footer */}
      </div>
    </div>
  )}
</div>

<script>
  function setupFooterMapTriggers() {
    const containers = document.querySelectorAll('.location-map-container');
    containers.forEach((container) => {
      const button = container.querySelector<HTMLButtonElement>('.btn-load-map');
      const wrapper = container.querySelector<HTMLDivElement>('.map-frame-wrapper');

      if (!button || !wrapper) return;

      button.addEventListener('click', () => {
        const embedUrl = button.getAttribute('data-embed-url');
        if (!embedUrl) return;

        if (!wrapper.querySelector('iframe')) {
          const iframe = document.createElement('iframe');
          iframe.src = embedUrl;
          iframe.loading = 'lazy';
          iframe.width = '100%';
          iframe.height = '200';
          iframe.style.border = '0';
          iframe.title = 'Mapa interactivo de ubicación de Ferzamac en Sucre, Bolivia';
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
          wrapper.appendChild(iframe);
        }

        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          wrapper.classList.add('hidden');
          button.setAttribute('aria-expanded', 'false');
          button.innerHTML = `
            <svg class="h-3.5 w-3.5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
            Ver mapa
          `;
        } else {
          wrapper.classList.remove('hidden');
          button.setAttribute('aria-expanded', 'true');
          button.innerHTML = `
            <svg class="h-3.5 w-3.5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Ocultar mapa
          `;
        }
      });
    });
  }

  setupFooterMapTriggers();
  document.addEventListener('astro:page-load', setupFooterMapTriggers);
</script>
