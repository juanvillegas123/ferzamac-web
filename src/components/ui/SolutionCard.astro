---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Badge from './Badge.astro';

interface Props {
  title: string;
  href: string;
  area: 'industrial' | 'hospitalaria';
  summary: string;
  specs?: { label: string; value: string }[];
  image?: ImageMetadata;
  imageAspectRatio?: '16/9' | '4/3' | '3/4' | '1/1';
  imagePosition?: string;
  class?: string;
}

const {
  title,
  href,
  area,
  summary,
  specs,
  image,
  imageAspectRatio = '16/9',
  imagePosition = 'object-center',
  class: className = '',
} = Astro.props;

const aspectClasses = {
  '16/9': 'aspect-16/9',
  '4/3': 'aspect-4/3',
  '3/4': 'aspect-3/4',
  '1/1': 'aspect-square',
};

const areaAccents = {
  industrial: 'border-t-industrial hover:border-industrial/60',
  hospitalaria: 'border-t-hospitalaria hover:border-hospitalaria/60',
};

const areaLabels = {
  industrial: 'Industrial',
  hospitalaria: 'Hospitalaria',
};
---

<article
  class={`group relative flex flex-col overflow-hidden rounded border border-line bg-white shadow-xs transition-shadow duration-200 hover:shadow-md border-t-4 ${areaAccents[area]} ${className}`}
>
  {image ? (
    <div
      class={`${aspectClasses[imageAspectRatio]} w-full overflow-hidden bg-surface`}
    >
      <Picture
        src={image}
        formats={['avif', 'webp']}
        alt={title}
        widths={[400, 700]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        class={`h-full w-full object-cover ${imagePosition} transition-transform duration-200 group-hover:scale-102`}
      />
    </div>
  ) : (
    import.meta.env.DEV && (
      <div
        class={`${aspectClasses[imageAspectRatio]} w-full flex items-center justify-center bg-surface border-b border-line text-xs font-mono text-muted`}
      >
        <span>Imagen pendiente</span>
      </div>
    )
  )}

  <div class="flex flex-1 flex-col p-5 space-y-3">
    <div>
      <Badge variant={area}>{areaLabels[area]}</Badge>
    </div>

    <h3 class="text-lg font-display font-semibold text-ink leading-snug">
      <a
        href={href}
        class="focus-visible:outline-2 focus-visible:outline-ink focus-visible:outline-offset-2 rounded"
      >
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <p class="text-sm text-muted line-clamp-3 leading-relaxed flex-1">
      {summary}
    </p>

    {specs && specs.length > 0 && (
      <div class="pt-2 border-t border-line space-y-1 text-xs">
        {specs.slice(0, 3).map((spec) => (
          <div class="flex justify-between py-0.5 text-muted border-b border-line/40 last:border-none">
            <span class="font-medium text-ink">{spec.label}:</span>
            <span class="text-right">{spec.value}</span>
          </div>
        ))}
      </div>
    )}

    <div class="pt-2 flex items-center gap-1 text-xs font-semibold text-ink group-hover:underline">
      <span>Ver especificaciones técnicas</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</article>
