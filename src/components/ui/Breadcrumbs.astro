---
import { pathWithBase } from '../../lib/path';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;

// Evitar duplicar "Inicio" si ya viene incluido en items
const filteredItems = items.filter(
  (item, index) =>
    !(
      index === 0 &&
      (item.href === '/' ||
        item.href === pathWithBase('/') ||
        item.label.toLowerCase() === 'inicio')
    )
);
---

<nav aria-label="Migas de pan" class={`text-xs sm:text-sm ${className}`}>
  <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-muted">
    <li>
      <a
        href={pathWithBase('/')}
        class="transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-ink rounded"
      >
        Inicio
      </a>
    </li>
    {filteredItems.map((item, index) => {
      const isLast = index === filteredItems.length - 1;
      return (
        <li class="flex items-center gap-1.5 sm:gap-2">
          <span class="text-line" aria-hidden="true">
            /
          </span>
          {isLast || !item.href ? (
            <span
              class="font-medium text-ink truncate max-w-[200px] sm:max-w-none"
              aria-current={isLast ? 'page' : undefined}
            >
              {item.label}
            </span>
          ) : (
            <a
              href={pathWithBase(item.href)}
              class="transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-ink rounded"
            >
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
