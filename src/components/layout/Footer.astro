---
import { SITE } from '../../lib/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-ink-deep text-white border-t border-ink-deep mt-auto">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4">
      <!-- Columna 1: Marca y descripción -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="inline-block focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-4 rounded">
          <img
            src="/logo/logo-ferzamac-blanco.svg"
            alt="Ferzamac"
            class="h-10 w-auto"
            width="164"
            height="40"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-white/80 leading-relaxed">
          {SITE.tagline}
        </p>
      </div>

      <!-- Columna 2: Áreas de especialidad -->
      <div>
        <h3 class="font-display text-sm font-semibold tracking-wider uppercase text-white mb-4">
          Áreas
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/industrial" class="text-white/80 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white">
              Área Industrial
            </a>
          </li>
          <li>
            <a href="/hospitalaria" class="text-white/80 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white">
              Área Hospitalaria
            </a>
          </li>
          <li>
            <a href="/consultoria" class="text-white/80 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white">
              Consultoría e Ingeniería
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Empresa -->
      <div>
        <h3 class="font-display text-sm font-semibold tracking-wider uppercase text-white mb-4">
          Empresa
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/nosotros" class="text-white/80 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white">
              Nosotros
            </a>
          </li>
          <li>
            <a href="/proyectos" class="text-white/80 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white">
              Proyectos Realizados
            </a>
          </li>
          <li>
            <a href="/contacto" class="text-white/80 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white">
              Contacto y Cotizaciones
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Contacto -->
      <div>
        <h3 class="font-display text-sm font-semibold tracking-wider uppercase text-white mb-4">
          Contacto
        </h3>
        <ul class="space-y-2.5 text-sm text-white/80">
          <li class="flex items-start gap-2">
            <span class="sr-only">Dirección:</span>
            <span>{SITE.address}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="sr-only">Teléfono:</span>
            <a href={`tel:${SITE.phoneRaw}`} class="hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white">
              {SITE.phone}
            </a>
          </li>
          {
            SITE.email && (
              <li>
                <a href={`mailto:${SITE.email}`} class="hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white">
                  {SITE.email}
                </a>
              </li>
            )
          }
          {
            SITE.schedule && (
              <li class="text-xs text-white/70">
                Horario: {SITE.schedule}
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <!-- Barra inferior copyright -->
    <div class="mt-12 border-t border-white/15 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-white/70 gap-4">
      <p>© {currentYear} {SITE.name}. Todos los derechos reservados.</p>
      <p>{SITE.city}</p>
    </div>
  </div>
</footer>
