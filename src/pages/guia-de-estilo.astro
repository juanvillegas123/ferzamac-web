---
/**
 * PÁGINA TEMPORAL PARA FASE F1 · SISTEMA DE DISEÑO
 * IMPORTANTE: Esta página debe excluirse del sitemap y eliminarse antes del lanzamiento oficial.
 * Todos los datos contenidos en esta página son MARCADORES DE EJEMPLO OBVIAMENTE FALSOS
 * para validar componentes, responsive, contraste y accesibilidad.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SpecTable from '../components/ui/SpecTable.astro';
import Gallery from '../components/ui/Gallery.astro';
import VideoFrame from '../components/ui/VideoFrame.astro';
import AreaCard from '../components/ui/AreaCard.astro';
import SolutionCard from '../components/ui/SolutionCard.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';

import StatsStrip from '../components/sections/StatsStrip.astro';
import AreasSplit from '../components/sections/AreasSplit.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import EngineeringShowcase from '../components/sections/EngineeringShowcase.astro';
import FeaturedProjects from '../components/sections/FeaturedProjects.astro';
import BrandsStrip from '../components/sections/BrandsStrip.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import PageHeader from '../components/sections/PageHeader.astro';

import foto1 from '../assets/images/fotogramas/cajon-noqueo-vacuno-sopachuy-estructura.png';
import foto2 from '../assets/images/fotogramas/camara-de-frio-sopachuy-puerta.png';
import foto3 from '../assets/images/fotogramas/huacareta-clasificacion-naranjas-lavado.png';
import foto4 from '../assets/images/fotogramas/huacareta-clasificacion-naranjas-canales-de-clasificacion.png';

// --- FIXTURES TEMPORALES DE PRUEBA (MARCADORES OBVIAMENTE FALSOS) ---
const breadcrumbSample = [
  { label: 'Área de ejemplo', href: '#' },
  { label: 'Categoría de ejemplo', href: '#' },
  { label: 'Título de ejemplo' },
];

const sampleSpecs = [
  { label: 'Parámetro de ejemplo 1', value: '000 unidad' },
  { label: 'Parámetro de ejemplo 2', value: '000 unidad' },
  {
    label: 'Parámetro de ejemplo 3',
    value: 'Valor de especificación de ejemplo',
  },
  { label: 'Norma técnica de ejemplo', value: 'Norma de ejemplo 000' },
  { label: 'Sistema de control', value: 'Control de ejemplo' },
];

const gallerySample = [
  {
    src: foto1,
    alt: 'Imagen de ejemplo 1',
    caption: 'Pie de foto de ejemplo 1',
  },
  {
    src: foto2,
    alt: 'Imagen de ejemplo 2',
    caption: 'Pie de foto de ejemplo 2',
  },
  {
    src: foto3,
    alt: 'Imagen de ejemplo 3',
    caption: 'Pie de foto de ejemplo 3',
  },
  {
    src: foto4,
    alt: 'Imagen de ejemplo 4',
    caption: 'Pie de foto de ejemplo 4',
  },
];

const showcaseImagesSample = [
  { src: foto1, alt: 'Fotografía de ejemplo 1', label: 'Imagen de ejemplo 1' },
  { src: foto4, alt: 'Fotografía de ejemplo 2', label: 'Imagen de ejemplo 2' },
  { src: foto2, alt: 'Fotografía de ejemplo 3', label: 'Imagen de ejemplo 3' },
];

const featuredProjectsSample = [
  {
    title: 'Título de proyecto de ejemplo 1',
    href: '#',
    area: 'industrial' as const,
    location: 'Ubicación de ejemplo',
    summary:
      'Texto de ejemplo sobre el alcance del proyecto industrial para pruebas.',
    image: foto3,
    scope: [
      'Alcance de ejemplo 1',
      'Alcance de ejemplo 2',
      'Alcance de ejemplo 3',
    ],
  },
  {
    title: 'Título de proyecto de ejemplo 2',
    href: '#',
    area: 'industrial' as const,
    location: 'Ubicación de ejemplo',
    summary:
      'Texto de ejemplo con imagen vertical adaptada mediante object-position.',
    image: foto2,
    imageAspectRatio: '4/3' as const,
    imagePosition: 'object-top',
    scope: ['Alcance de ejemplo 1', 'Alcance de ejemplo 2'],
  },
  {
    title: 'Título de proyecto de ejemplo 3',
    href: '#',
    area: 'hospitalaria' as const,
    location: 'Ubicación de ejemplo',
    summary: 'Texto de ejemplo con imagen vertical adaptada en encuadre.',
    image: foto1,
    imageAspectRatio: '4/3' as const,
    imagePosition: 'object-top',
    scope: ['Alcance de ejemplo 1', 'Alcance de ejemplo 2'],
  },
];
---

<BaseLayout
  title="Catálogo de componentes (F1 - Temporal)"
  description="Validación completa del sistema de diseño, componentes UI y secciones para Ferzamac."
  noindex={true}
>
  <!-- Cabecera de la guía -->
  <header class="border-b border-line bg-surface py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-3">
      <span class="inline-block px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider bg-white text-ink border border-line rounded">
        Fase F1 · Sistema de diseño
      </span>
      <h1 class="text-3xl sm:text-4xl font-display font-semibold text-ink">
        Catálogo interactivo de componentes y secciones
      </h1>
      <p class="text-sm sm:text-base text-muted max-w-3xl leading-relaxed">
        Página de verificación de tokens, contraste WCAG AA, componentes UI,
        multimedia y maquetación responsiva a 375 px, 768 px y 1280 px.
      </p>
    </div>
  </header>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-20">
    <!-- 1. Tokens de color corporativos -->
    <section class="space-y-6" aria-labelledby="sec-tokens">
      <h2
        id="sec-tokens"
        class="text-2xl font-display font-semibold text-ink border-b border-line pb-2"
      >
        1. Tokens de color corporativos
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="rounded border border-line overflow-hidden bg-white shadow-xs">
          <div class="h-16 bg-ink"></div>
          <div class="p-3 text-xs space-y-1">
            <p class="font-bold text-ink text-sm">ink</p>
            <p class="text-muted font-mono">#0A4D5C</p>
          </div>
        </div>
        <div class="rounded border border-line overflow-hidden bg-white shadow-xs">
          <div class="h-16 bg-ink-deep"></div>
          <div class="p-3 text-xs space-y-1">
            <p class="font-bold text-ink text-sm">ink-deep</p>
            <p class="text-muted font-mono">#06323C</p>
          </div>
        </div>
        <div class="rounded border border-line overflow-hidden bg-white shadow-xs">
          <div class="h-16 bg-industrial"></div>
          <div class="p-3 text-xs space-y-1">
            <p class="font-bold text-ink text-sm">industrial</p>
            <p class="text-muted font-mono">#00B020</p>
          </div>
        </div>
        <div class="rounded border border-line overflow-hidden bg-white shadow-xs">
          <div class="h-16 bg-hospitalaria"></div>
          <div class="p-3 text-xs space-y-1">
            <p class="font-bold text-ink text-sm">hospitalaria</p>
            <p class="text-muted font-mono">#1DA1D2</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Badges y Botones -->
    <section class="space-y-6" aria-labelledby="sec-buttons-badges">
      <h2
        id="sec-buttons-badges"
        class="text-2xl font-display font-semibold text-ink border-b border-line pb-2"
      >
        2. Badges y Botones
      </h2>
      <div class="space-y-6">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-3">
            Badges (Texto siempre en ink)
          </h3>
          <div class="flex flex-wrap items-center gap-3">
            <Badge variant="neutral">Neutro de ejemplo</Badge>
            <Badge variant="industrial">Industrial de ejemplo</Badge>
            <Badge variant="hospitalaria">Hospitalaria de ejemplo</Badge>
          </div>
        </div>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-3">
            Botones interactivos
          </h3>
          <div class="flex flex-wrap items-center gap-4">
            <Button variant="primary" size="sm">
              Primario sm
            </Button>
            <Button variant="primary" size="md">
              Primario md
            </Button>
            <Button variant="primary" size="lg">
              Primario lg
            </Button>
            <Button variant="secondary" size="sm">
              Secundario sm
            </Button>
            <Button variant="secondary" size="md">
              Secundario md
            </Button>
            <Button variant="secondary" size="lg">
              Secundario lg
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Encabezados, Breadcrumbs y Tabla de Especificaciones -->
    <section class="space-y-6" aria-labelledby="sec-ui-elements">
      <h2
        id="sec-ui-elements"
        class="text-2xl font-display font-semibold text-ink border-b border-line pb-2"
      >
        3. Breadcrumbs, SectionHeading y SpecTable
      </h2>
      <div class="space-y-8">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-2">
            Migas de pan (Breadcrumbs)
          </h3>
          <Breadcrumbs items={breadcrumbSample} />
        </div>

        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-2">
            Encabezado de sección (SectionHeading)
          </h3>
          <SectionHeading
            eyebrow="Eyebrow de ejemplo"
            title="Título de sección de ejemplo"
            intro="Texto de introducción de ejemplo para contextualizar bloques técnicos."
          />
        </div>

        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-2">
            Tabla de especificaciones apilable (SpecTable)
          </h3>
          <SpecTable
            caption="Tabla de especificaciones de ejemplo"
            rows={sampleSpecs}
          />
        </div>
      </div>
    </section>

    <!-- 4. Galería multimedia con visor modal y VideoFrame -->
    <section class="space-y-6" aria-labelledby="sec-multimedia">
      <h2
        id="sec-multimedia"
        class="text-2xl font-display font-semibold text-ink border-b border-line pb-2"
      >
        4. Multimedia accesible (Gallery con diálogo nativo y VideoFrame)
      </h2>
      <div class="space-y-8">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-3">
            Galería con visor modal accesible por teclado (&lt;dialog&gt;)
          </h3>
          <Gallery images={gallerySample} columns={4} />
        </div>

        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-3">
            Reproductor de video con IntersectionObserver (sin CLS)
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            <div class="space-y-2">
              <span class="text-xs font-semibold text-muted">
                Video panorámico ('wide')
              </span>
              <VideoFrame
                src="/video/huacareta-clasificacion-naranjas-01-alimentacion.mp4"
                poster={foto3.src}
                orientation="wide"
                caption="Pie de foto de ejemplo para video panorámico."
              />
            </div>
            <div class="space-y-2">
              <span class="text-xs font-semibold text-muted">
                Video vertical ('vertical')
              </span>
              <VideoFrame
                src="/video/camara-de-frio-sopachuy-puerta-y-tablero.mp4"
                poster={foto2.src}
                orientation="vertical"
                caption="Pie de foto de ejemplo para video vertical."
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Tarjetas (AreaCard, SolutionCard, ProjectCard) -->
    <section class="space-y-6" aria-labelledby="sec-cards">
      <h2
        id="sec-cards"
        class="text-2xl font-display font-semibold text-ink border-b border-line pb-2"
      >
        5. Tarjetas de catálogo y proyectos
      </h2>
      <div class="space-y-8">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-3">
            AreaCard (División de especialidad)
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <AreaCard
              title="Área Industrial de ejemplo"
              href="/industrial"
              area="industrial"
              description="Texto de ejemplo para la descripción de servicios y capacidades del área industrial."
              highlights={[
                'Especialidad de ejemplo A',
                'Especialidad de ejemplo B',
                'Especialidad de ejemplo C',
              ]}
            />
            <AreaCard
              title="Área Hospitalaria de ejemplo"
              href="/hospitalaria"
              area="hospitalaria"
              description="Texto de ejemplo para la descripción de servicios y capacidades del área hospitalaria."
              highlights={[
                'Especialidad de ejemplo X',
                'Especialidad de ejemplo Y',
                'Especialidad de ejemplo Z',
              ]}
            />
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-3">
            SolutionCard (Acento según área y encuadre ajustable)
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <SolutionCard
              title="Título de ejemplo de solución industrial"
              href="#"
              area="industrial"
              summary="Texto de ejemplo describiendo las características generales del equipo o servicio."
              specs={[
                { label: 'Parámetro de ejemplo', value: '000 unidad' },
                { label: 'Capacidad de ejemplo', value: '000 unidad' },
              ]}
              image={foto1}
              imageAspectRatio="4/3"
              imagePosition="object-top"
            />
            <SolutionCard
              title="Título de ejemplo de solución hospitalaria"
              href="#"
              area="hospitalaria"
              summary="Texto de ejemplo describiendo las características generales del sistema hospitalario."
              specs={[
                { label: 'Parámetro de ejemplo', value: '000 unidad' },
                { label: 'Caudal de ejemplo', value: '000 unidad' },
              ]}
              image={foto2}
              imageAspectRatio="4/3"
              imagePosition="object-top"
            />
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-muted mb-3">
            ProjectCard (Ficha de caso real de ejemplo)
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <ProjectCard
              title="Título de proyecto de ejemplo A"
              href="#"
              area="industrial"
              location="Ubicación de ejemplo"
              summary="Texto de ejemplo resumiendo el alcance técnico general del proyecto realizado."
              image={foto3}
              scope={[
                'Alcance de ejemplo 1',
                'Alcance de ejemplo 2',
                'Alcance de ejemplo 3',
              ]}
            />
            <ProjectCard
              title="Título de proyecto de ejemplo B"
              href="#"
              area="hospitalaria"
              location="Ubicación de ejemplo"
              summary="Texto de ejemplo resumiendo el alcance técnico con imagen vertical ajustada."
              image={foto4}
              scope={[
                'Alcance de ejemplo 1',
                'Alcance de ejemplo 2',
                'Alcance de ejemplo 3',
              ]}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Secciones estructurales -->
    <section class="space-y-6" aria-labelledby="sec-sections">
      <h2
        id="sec-sections"
        class="text-2xl font-display font-semibold text-ink border-b border-line pb-2"
      >
        6. Secciones estructurales completas
      </h2>
      <div class="space-y-12 border border-line rounded p-4 sm:p-6 bg-white">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
            StatsStrip (Solo si tiene datos confirmados)
          </h3>
          <StatsStrip
            stats={[
              { value: '00', label: 'Cifra de ejemplo [por confirmar]' },
              { value: '00%', label: 'Porcentaje de ejemplo [por confirmar]' },
            ]}
          />
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
            AreasSplit
          </h3>
          <AreasSplit
            title="Divisiones técnicas de ejemplo"
            intro="Texto de ejemplo sobre las áreas de especialidad."
            industrialHighlights={[
              'Especialidad de ejemplo 1',
              'Especialidad de ejemplo 2',
            ]}
            hospitalariaHighlights={[
              'Especialidad de ejemplo A',
              'Especialidad de ejemplo B',
            ]}
          />
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
            ProcessSteps
          </h3>
          <ProcessSteps
            title="Proceso de trabajo de ejemplo"
            intro="Texto de ejemplo sobre las fases de ejecución."
          />
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
            EngineeringShowcase (Rotulado como imágenes de ejemplo)
          </h3>
          <EngineeringShowcase
            title="Capacidad técnica de ejemplo"
            intro="Texto de ejemplo sobre modelado y diseño técnico."
            images={showcaseImagesSample}
          />
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
            FeaturedProjects
          </h3>
          <FeaturedProjects
            title="Proyectos destacados de ejemplo"
            intro="Texto de ejemplo sobre proyectos realizados."
            projects={featuredProjectsSample}
          />
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
            BrandsStrip (Solo marcas con mostrar: true)
          </h3>
          <BrandsStrip />
        </div>

        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-muted mb-2">
            CtaBanner
          </h3>
          <CtaBanner
            title="Título de llamado a la acción de ejemplo"
            description="Texto de ejemplo para solicitar cotización técnica de plantas o equipos."
          />
        </div>
      </div>
    </section>

    <!-- 7. Maqueta de Ficha Técnica con DetailLayout -->
    <section class="space-y-6" aria-labelledby="sec-detail-mockup">
      <h2
        id="sec-detail-mockup"
        class="text-2xl font-display font-semibold text-ink border-b border-line pb-2"
      >
        7. Maqueta representativa de DetailLayout
      </h2>
      <div class="rounded border-2 border-dashed border-line p-6 bg-surface space-y-6">
        <PageHeader
          title="Título de ficha técnica de ejemplo"
          breadcrumbs={breadcrumbSample}
          area="industrial"
          intro="Texto de introducción de ejemplo para la ficha técnica del equipo o servicio."
        />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-8 space-y-8">
            <div class="space-y-4 text-sm text-ink leading-relaxed">
              <h3 class="text-xl font-display font-semibold text-ink">
                Descripción del equipo o servicio de ejemplo
              </h3>
              <p>
                Texto de ejemplo describiendo el funcionamiento, diseño y
                aplicaciones del equipo o sistema. Este párrafo es un marcador
                visual para validar el espaciado y la tipografía en la
                plantilla.
              </p>
            </div>

            <SpecTable
              caption="Parámetros técnicos de ejemplo"
              rows={sampleSpecs}
            />

            <div>
              <h3 class="text-lg font-display font-semibold text-ink mb-3">
                Registro fotográfico de ejemplo
              </h3>
              <Gallery images={gallerySample.slice(0, 3)} columns={3} />
            </div>
          </div>

          <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
            <div class="rounded border border-line bg-white p-6 shadow-xs space-y-4">
              <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted">
                Cotización técnica
              </span>
              <h3 class="font-display text-lg font-semibold text-ink">
                Solicitar cotización de Título de ejemplo
              </h3>
              <p class="text-xs text-muted leading-relaxed">
                Texto de ejemplo para solicitar cotización técnica y consultar
                plazos de ejecución.
              </p>
              <Button
                href="/contacto"
                variant="primary"
                size="md"
                class="w-full"
              >
                Cotizar por WhatsApp
              </Button>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
