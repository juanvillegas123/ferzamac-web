---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

const disciplinas = [
  'Ingeniería Industrial',
  'Ingeniería Mecánica',
  'Ingeniería Mecatrónica',
  'Ingeniería Eléctrica y Electrónica',
  'Especialistas en Automatización de Procesos',
  'Personal técnico especializado',
];
---

<BaseLayout
  title="Nosotros | Ferzamac"
  description="Empresa especializada en diseño, construcción, montaje y mantenimiento de plantas, equipos y máquinas industriales en Sucre, Bolivia."
>
  <PageHeader
    title="Nosotros"
    breadcrumbs={[{ label: 'Nosotros' }]}
    intro="Empresa especializada en diseño, construcción, montaje, mantenimiento y consultoría de plantas, equipos y maquinaria industrial."
  />

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-16">
    <!-- Presentación de la empresa (Texto provisional a aprobar por el cliente / Catálogo pág. 2) -->
    <section class="max-w-4xl space-y-6">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted">
        Perfil empresarial
      </span>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink">
        Ingeniería, montaje y mantenimiento industrial
      </h2>
      <div class="space-y-4 text-base sm:text-lg text-ink/90 leading-relaxed">
        <p>
          Ferzamac es una empresa con sede en Bolivia especializada en diseño, construcción, montaje, mantenimiento preventivo y correctivo y puesta en marcha de plantas, equipos y máquinas industriales. También ofrece consultoría en auditoría técnica industrial, valoración, dimensionamiento y memoria de cálculo.
        </p>
      </div>
    </section>

    <!-- Misión y Visión -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8" aria-label="Misión y Visión">
      <div class="rounded-lg border border-line bg-surface p-6 sm:p-8 space-y-3">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-industrial" aria-hidden="true"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-muted">
            Propósito
          </span>
        </div>
        <h3 class="font-display text-xl font-semibold text-ink">
          Misión
        </h3>
        <p class="text-sm sm:text-base text-ink/90 leading-relaxed">
          Poner a disposición de nuestros clientes la aplicación de la ingeniería integrada con el objeto de optimizar procesos a través de la automatización, con perspectiva económica, sostenible y segura.
        </p>
      </div>

      <div class="rounded-lg border border-line bg-surface p-6 sm:p-8 space-y-3">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-hospitalaria" aria-hidden="true"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-muted">
            Proyección
          </span>
        </div>
        <h3 class="font-display text-xl font-semibold text-ink">
          Visión
        </h3>
        <p class="text-sm sm:text-base text-ink/90 leading-relaxed">
          Ser reconocidos a nivel nacional como la empresa líder en brindar servicios y equipos innovadores y de excelente calidad, de forma transparente, humana y sostenible, generando valor a nuestros clientes y grupos de interés.
        </p>
      </div>
    </section>

    <!-- Nuestro equipo de trabajo (Catálogo pág. 3) -->
    <section class="rounded-lg border border-line bg-surface p-8 sm:p-10 space-y-8">
      <div class="max-w-3xl space-y-2">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted">
          Capacidad técnica
        </span>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink">
          Nuestro equipo de trabajo
        </h2>
        <p class="text-sm sm:text-base text-muted leading-relaxed">
          Contamos con personal especializado en las siguientes áreas de ingeniería y técnica industrial:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {disciplinas.map((item) => (
          <div class="flex items-center gap-3 rounded border border-line bg-white p-4 shadow-xs">
            <span class="h-2 w-2 rounded-full bg-industrial shrink-0" aria-hidden="true"></span>
            <span class="font-display text-sm font-semibold text-ink">{item}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Metodología de trabajo -->
    <ProcessSteps
      eyebrow="Metodología"
      title="Fases de desarrollo técnico"
    />

    <CtaBanner
      title="¿Requiere asesoramiento para su proyecto?"
      description="Consulte directamente con nuestro equipo de ingeniería."
      primaryCta={{ label: 'Solicitar cotización', href: '/contacto' }}
      secondaryCta={{ label: 'Ver proyectos ejecutados', href: '/proyectos' }}
    />
  </div>
</BaseLayout>
