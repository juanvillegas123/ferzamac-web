---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import SolutionCard from '../components/ui/SolutionCard.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

const solutions = await getCollection('soluciones', (s) => s.data.area === 'consultoria');
const hasSolutions = solutions.length > 0;
---

<BaseLayout
  title="Consultoría técnica | Ferzamac"
  description="Servicios de consultoría, auditoría técnica de tipo industrial, valoración, dimensionamiento y elaboración de memorias de cálculo."
  noindex={true}
>
  <PageHeader
    title="Consultoría técnica"
    area="consultoria"
    breadcrumbs={[{ label: 'Consultoría' }]}
    intro="Servicios de consultoría técnica en auditoría de tipo industrial, valoración, dimensionamiento y elaboración de memorias de cálculo para plantas y equipos."
  />

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-12">
    <!-- Texto de consultoría según catálogo pág. 2 -->
    <section class="max-w-4xl space-y-6">
      <h2 class="font-display text-2xl font-semibold text-ink">
        Estudios y desarrollo de ingeniería
      </h2>
      <div class="space-y-4 text-sm sm:text-base text-ink/90 leading-relaxed">
        <p>
          Ferzamac brinda servicios especializados de consultoría técnica en auditoría de tipo industrial,
          valoración, dimensionamiento y elaboración de memorias de cálculo, entre otros.
        </p>
        <p>
          Asimismo, elabora estudios y diseños técnicos de plantas industriales de acopio y transformación
          (maquinaria, equipo industrial, herramientas y líneas de producción para procesamiento de alimentos y agroindustria).
        </p>
      </div>
    </section>

    {hasSolutions ? (
      <div class="space-y-6">
        <h2 class="font-display text-xl font-semibold text-ink">
          Servicios registrados
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {solutions.map((solution) => (
            <SolutionCard
              title={solution.data.title}
              href={`/consultoria/${solution.id}`}
              area="consultoria"
              summary={solution.data.resumen}
              specs={solution.data.specs}
              image={solution.data.imagenPrincipal}
              imageAlt={solution.data.imagenPrincipalAlt}
            />
          ))}
        </div>
      </div>
    ) : (
      <div class="rounded-lg border border-dashed border-line bg-surface p-8 text-center text-sm text-muted">
        <p>Contenido en preparación</p>
      </div>
    )}

    <CtaBanner
      title="¿Requiere consultoría o estudio técnico?"
      description="Consulte con nuestro equipo de ingenieros para formulación y dimensionamiento de plantas."
      primaryCta={{ label: 'Solicitar cotización', href: '/contacto' }}
      secondaryCta={{ label: 'Ver catálogo industrial', href: '/industrial' }}
    />
  </div>
</BaseLayout>
