---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Inicio"
  description="Ferzamac: diseño, construcción, montaje y mantenimiento industrial y hospitalario en Sucre y Bolivia."
>
  <section class="py-20 bg-surface border-b border-line">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wider uppercase bg-ink/10 text-ink rounded">
        Fase F0 · Base operativa
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-semibold text-ink tracking-tight">
        Ferzamac — Ingeniería y Mantenimiento Industrial y Hospitalario
      </h1>
      <p class="text-base sm:text-lg text-muted max-w-2xl mx-auto leading-relaxed">
        Soluciones integrales de diseño, construcción, montaje y mantenimiento
        de plantas, equipos y sistemas hospitalarios en Bolivia.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <Button href="/guia-de-estilo" variant="primary" size="md">
          Ver guía de estilo (F0)
        </Button>
        <Button href="/contacto" variant="secondary" size="md">
          Contacto y cotizaciones
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
