---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import AreasSplit from '../components/sections/AreasSplit.astro';
import FeaturedProjects from '../components/sections/FeaturedProjects.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import EngineeringShowcase from '../components/sections/EngineeringShowcase.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import ClientsStrip from '../components/sections/ClientsStrip.astro';
import ContactForm from '../components/ui/ContactForm.astro';

import heroImg from '../assets/images/home/hero-generacion-vapor-huacareta.jpg';
import render1 from '../assets/images/home/ingenieria-diseno-3d-01.jpg';
import render2 from '../assets/images/home/ingenieria-diseno-3d-02.jpg';
import render3 from '../assets/images/home/ingenieria-diseno-3d-03.jpg';

const featuredProjects = await getCollection('proyectos', (p) => p.data.destacado);

const featuredProjectsData = featuredProjects.map((p) => ({
  title: p.data.title,
  href: `/proyectos/${p.id}`,
  area: p.data.area,
  location: p.data.ubicacion,
  summary: p.data.resumen,
  image: p.data.imagenPrincipal,
  imageAlt: p.data.imagenPrincipalAlt,
  scope: p.data.alcance,
}));

// Clientes autorizados para publicación (mostrarNombre: true)
const clients = await getCollection('clientes', (c) => c.data.mostrarNombre);
const clientsData = clients.map((c) => ({
  nombre: c.data.nombre,
  mostrarNombre: c.data.mostrarNombre,
  logo: c.data.logo,
}));

const showcaseImages = [
  { src: render1, alt: 'Diseño 3D de planta', label: 'Render de diseño' },
  { src: render2, alt: 'Diseño 3D de estructura', label: 'Render de diseño' },
  { src: render3, alt: 'Diseño 3D de equipo industrial', label: 'Render de diseño' },
];
---

<BaseLayout
  title="Ferzamac | Plantas y equipos industriales en Bolivia"
  description="Diseño, construcción, montaje y mantenimiento de plantas, equipos y máquinas industriales en Sucre y Bolivia."
>
  <!-- Hero -->
  <Hero
    title="Diseño, construcción, montaje y mantenimiento de plantas y equipos"
    subtitle="Plantas, equipos y máquinas industriales, puesta en marcha y servicios de consultoría técnica."
    backgroundImage={heroImg}
    primaryCta={{ label: 'Ver proyectos', href: '/proyectos' }}
    secondaryCta={{ label: 'Solicitar cotización', href: '/contacto' }}
  />

  <!-- Presentación institucional (Texto provisional a aprobar por el cliente) -->
  <section class="border-b border-line bg-surface py-12 sm:py-14" aria-label="Presentación institucional">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted">
        Ingeniería, montaje y mantenimiento
      </span>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink">
        Especialistas en plantas y equipos industriales
      </h2>
      <p class="text-base sm:text-lg text-ink/90 leading-relaxed max-w-3xl mx-auto">
        Ferzamac es una empresa con sede en Bolivia especializada en diseño, construcción, montaje, mantenimiento preventivo y correctivo y puesta en marcha de plantas, equipos y máquinas industriales. También ofrece consultoría en auditoría técnica industrial, valoración, dimensionamiento y memoria de cálculo.
      </p>
    </div>
  </section>

  <!-- AreasSplit -->
  <AreasSplit
    eyebrow="Divisiones técnicas"
    title="Áreas de especialidad"
    industrialTitle="Área Industrial"
    industrialDescription="Diseño, construcción, montaje, mantenimiento preventivo y correctivo de plantas, equipos y máquinas industriales."
    industrialHighlights={[
      'Plantas y equipos industriales',
      'Maquinaria y calderería',
      'Mantenimiento preventivo y correctivo',
    ]}
    hospitalariaTitle="Área Hospitalaria"
    hospitalariaDescription="Plantas de tratamiento de agua purificada, sistemas de aire comprimido y mantenimiento de plantas para hemodiálisis."
    hospitalariaHighlights={[
      'Tratamiento de agua purificada',
      'Sistemas de aire comprimido',
      'Plantas para hemodiálisis',
    ]}
  />

  <!-- FeaturedProjects -->
  <FeaturedProjects
    title="Proyectos destacados"
    intro="Instalaciones y montajes industriales ejecutados por nuestro equipo."
    projects={featuredProjectsData}
  />

  <!-- ProcessSteps -->
  <ProcessSteps
    eyebrow="Metodología"
    title="Proceso de trabajo"
  />

  <!-- EngineeringShowcase -->
  <EngineeringShowcase
    title="Diseño de plantas y equipos"
    images={showcaseImages}
    ctaHref="/contacto"
    ctaLabel="Consultar con ingeniería"
  />

  <!-- Clientes (solo se muestra si existen clientes con logo y mostrarNombre: true) -->
  <ClientsStrip clientes={clientsData} />

  <!-- CtaBanner -->
  <CtaBanner
    title="¿Requiere cotización técnica para su planta o equipo?"
    description="Consulte con nuestro equipo para asesoramiento técnico y formulación de proyectos industriales y hospitalarios."
    primaryCta={{ label: 'Solicitar cotización', href: '/contacto' }}
    secondaryCta={{ label: 'Ver proyectos', href: '/proyectos' }}
  />

  <!-- Formulario de contacto rápido antes del footer -->
  <section class="bg-surface py-12 sm:py-16 border-t border-line" aria-label="Contacto rápido">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="text-center space-y-2">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted">
          Contacto directo
        </span>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink">
          Solicite información técnica o cotización
        </h2>
        <p class="text-sm text-muted max-w-xl mx-auto leading-relaxed">
          Envíenos sus requerimientos para coordinar con nuestro equipo técnico en Sucre, Bolivia.
        </p>
      </div>

      <ContactForm variant="compact" />
    </div>
  </section>
</BaseLayout>
