---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import LocationMap from '../components/ui/LocationMap.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="Contacto | Ferzamac"
  description="Comuníquese con Ferzamac en Sucre, Bolivia para cotizaciones y consultas técnicas sobre plantas y equipos industriales."
>
  <PageHeader
    title="Contacto"
    breadcrumbs={[{ label: 'Contacto' }]}
    intro="Comuníquese directamente con nuestro equipo para cotizaciones, dimensionamiento y consultas técnicas sobre proyectos industriales y hospitalarios."
  />

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Datos directos de contacto -->
      <div class="lg:col-span-6 space-y-8">
        <div class="space-y-4">
          <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted">
            Canales de atención
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink">
            Atención directa y ubicación
          </h2>
          <p class="text-base text-muted leading-relaxed">
            Para coordinar visitas técnicas, solicitud de cotizaciones o consultas de ingeniería:
          </p>
        </div>

        <div class="space-y-6">
          <!-- Teléfono -->
          <div class="rounded-lg border border-line bg-surface p-6 shadow-xs space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">
              Teléfono de contacto
            </span>
            <!-- TODO: confirmar con el cliente (viene del sitio actual) -->
            <div>
              <a
                href={`tel:${SITE.phoneRaw}`}
                class="font-display text-2xl font-bold text-ink hover:underline focus-visible:outline-2 focus-visible:outline-ink rounded"
              >
                {SITE.phone}
              </a>
            </div>
            <p class="text-xs text-muted">
              Llamadas directas para consultas técnicas y cotizaciones.
            </p>
          </div>

          <!-- Dirección física y mapa diferido -->
          <LocationMap variant="card" />
        </div>
      </div>

      <!-- Formulario de contacto (o datos directos si PUBLIC_FORM_ENDPOINT no está configurado) -->
      <div class="lg:col-span-6">
        <ContactForm variant="full" />
      </div>
    </div>
  </div>
</BaseLayout>
