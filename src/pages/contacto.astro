---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import LocationMap from '../components/ui/LocationMap.astro';
import ContactForm from '../components/ui/ContactForm.astro';
import ClientsStrip from '../components/sections/ClientsStrip.astro';
import BrandsStrip from '../components/sections/BrandsStrip.astro';
import { SITE } from '../lib/site';
import { getWhatsAppLink } from '../lib/whatsapp';

import workshopImage from '../assets/images/home/hero-generacion-vapor-huacareta.jpg';

const whatsappHref = getWhatsAppLink(
  'Hola Ferzamac, deseo solicitar una cotización técnica.'
);
---

<BaseLayout
  title="Contacto | Ferzamac"
  description="Comuníquese con Ferzamac en Sucre, Bolivia por WhatsApp (+591 72877116), correo (info@ferzamac.com) o visítenos en Calle René Moreno Nº 162."
  breadcrumbs={[{ label: 'Contacto', href: '/contacto' }]}
>
  <PageHeader
    title="Contacto"
    breadcrumbs={[{ label: 'Contacto' }]}
    intro="Comuníquese directamente con nuestro equipo de ingeniería para cotizaciones, dimensionamiento técnico y coordinación de visitas en plantas industriales y centros hospitalarios."
  />

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-12">
    <!-- Fila superior: 3 Canales de atención rápida (Sin redundancia) -->
    <section
      aria-label="Canales de atención directa"
      class="grid grid-cols-1 md:grid-cols-3 gap-6"
    >
      <!-- Canal WhatsApp -->
      <div class="rounded-xl border border-line bg-white p-6 shadow-xs flex flex-col justify-between space-y-4 hover:border-[#99DFAB] transition-colors">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[#EAF7ED] text-[#00B020]">
              <svg
                class="h-6 w-6 fill-current"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
              </svg>
            </span>
            <span class="rounded-full bg-[#EAF7ED] px-2.5 py-0.5 text-[11px] font-semibold text-[#0B6B22]">
              Atención inmediata
            </span>
          </div>
          <div>
            <h3 class="font-display text-base font-semibold text-ink">
              WhatsApp Directo
            </h3>
            <p class="text-xs text-muted mt-1 leading-relaxed">
              Consultas técnicas rápidas, coordinación y cotizaciones en línea
              con nuestro equipo.
            </p>
          </div>
          <div class="pt-1">
            <span class="font-display text-lg font-bold text-ink">
              {SITE.phone}
            </span>
          </div>
        </div>
        <div class="pt-2">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B020] px-4 py-2.5 text-xs font-semibold text-white shadow-xs hover:bg-[#00961B] focus-visible:outline-2 focus-visible:outline-ink transition-colors"
          >
            <span>Iniciar chat por WhatsApp</span>
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </a>
        </div>
      </div>

      <!-- Canal Teléfono -->
      <div class="rounded-xl border border-line bg-white p-6 shadow-xs flex flex-col justify-between space-y-4 hover:border-ink/40 transition-colors">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-surface text-ink">
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
            </span>
            <span class="rounded-full bg-surface px-2.5 py-0.5 text-[11px] font-semibold text-muted">
              Llamada directa
            </span>
          </div>
          <div>
            <h3 class="font-display text-base font-semibold text-ink">
              Línea Telefónica
            </h3>
            <p class="text-xs text-muted mt-1 leading-relaxed">
              Coordinación de inspecciones en planta, visitas técnicas y
              requerimientos de urgencia.
            </p>
          </div>
          <div class="pt-1">
            <span class="font-display text-lg font-bold text-ink">
              {SITE.phone}
            </span>
          </div>
        </div>
        <div class="pt-2">
          <a
            href={`tel:${SITE.phoneRaw}`}
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-ink px-4 py-2.5 text-xs font-semibold text-white shadow-xs hover:bg-ink-deep focus-visible:outline-2 focus-visible:outline-ink transition-colors"
          >
            <span>Llamar por teléfono</span>
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              />
            </svg>
          </a>
        </div>
      </div>

      <!-- Canal Correo -->
      <div class="rounded-xl border border-line bg-white p-6 shadow-xs flex flex-col justify-between space-y-4 hover:border-hospitalaria/50 transition-colors">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[#EBF7FC] text-[#1DA1D2]">
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
              </svg>
            </span>
            <span class="rounded-full bg-[#EBF7FC] px-2.5 py-0.5 text-[11px] font-semibold text-[#0E7A9E]">
              Planos y TDR
            </span>
          </div>
          <div>
            <h3 class="font-display text-base font-semibold text-ink">
              Correo Electrónico
            </h3>
            <p class="text-xs text-muted mt-1 leading-relaxed">
              Envío de especificaciones técnicas, pliegos licitatorios y
              documentación de ingeniería.
            </p>
          </div>
          <div class="pt-1">
            <span class="font-display text-lg font-bold text-ink">
              {SITE.email}
            </span>
          </div>
        </div>
        <div class="pt-2">
          <a
            href={`mailto:${SITE.email}`}
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-line bg-surface px-4 py-2.5 text-xs font-semibold text-ink hover:bg-line focus-visible:outline-2 focus-visible:outline-ink transition-colors"
          >
            <span>Enviar correo técnico</span>
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Sección principal: Formulario a la izquierda y Sede / Mapa interactivo a la derecha -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      <!-- Columna izquierda: Formulario funcional -->
      <div class="lg:col-span-7">
        <ContactForm
          variant="full"
          title="Solicitud de cotización técnica"
          description="Complete los datos de su requerimiento. Puede remitir la solicitud por correo electrónico o transferirla automáticamente a WhatsApp."
        />
      </div>

      <!-- Columna derecha: Taller, Sede central y Google Maps Interactivo -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Tarjeta viva con imagen de taller e información de sede -->
        <div class="overflow-hidden rounded-xl border border-line bg-white shadow-xs">
          <div class="relative h-44 w-full overflow-hidden bg-ink-deep">
            <Image
              src={workshopImage}
              alt="Instalaciones y equipos industriales de Ferzamac"
              width={640}
              height={360}
              class="h-full w-full object-cover opacity-80"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-ink-deep via-ink-deep/40 to-transparent"></div>
            <div class="absolute bottom-3 left-4 right-4">
              <span class="inline-block rounded-full bg-industrial/90 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-white">
                Sede Central y Maestranza
              </span>
              <p class="font-display text-sm font-bold text-white mt-0.5">
                Ferzamac · Sucre, Bolivia
              </p>
            </div>
          </div>

          <div class="p-5 space-y-4 text-xs">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-surface text-ink mt-0.5">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
              </span>
              <div>
                <p class="font-semibold text-ink text-sm">{SITE.address}</p>
                <p class="text-muted mt-0.5">
                  Sucre, Departamento de Chuquisaca, Bolivia
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3 border-t border-line/60 pt-3">
              <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-surface text-ink mt-0.5">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </span>
              <div>
                <p class="font-semibold text-ink">
                  Horario de atención en maestranza
                </p>
                <p class="text-muted mt-0.5">{SITE.schedule}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Google Maps interactivo estilizado con Pin de Ferzamac -->
        <LocationMap variant="card" />
      </div>
    </div>

    <!-- Carruseles de confianza -->
    <div class="space-y-6 pt-4 border-t border-line/60">
      <ClientsStrip />
      <BrandsStrip />
    </div>
  </div>
</BaseLayout>
